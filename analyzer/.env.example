# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Model + effort used for alert explanation. Defaults are sane; lower EFFORT
# to cut cost if you're enriching a large batch of alerts.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EFFORT=medium

# Where the enriched alert database lives. Leave unset to default to
# alerts.db next to this file, regardless of which directory you run from.
# DB_PATH=alerts.db
